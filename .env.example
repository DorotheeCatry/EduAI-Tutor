# Variables d'environnement d'EduAI Tutor.
#
# Copier ce fichier en `.env` et renseigner les valeurs. Aucun secret ne doit
# entrer ici : ce fichier est versionné, `.env` ne l'est pas.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- PostgreSQL : une instance, deux bases (décision 006) -----------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=eduai
POSTGRES_PASSWORD=
DJANGO_DB_NAME=eduai_app
POSTGRES_DB=eduai_data
EDUAI_DATA_USER=eduai_lecture
EDUAI_DATA_PASSWORD=

# --- Fournisseur de modèles ------------------------------------------------
GROQ_API_KEY=
USE_LOCAL_LLM=False
DEFAULT_LLM_MODEL=openai/gpt-oss-120b
# Un modèle par agent : le routage est un réglage, jamais du code (décision 001)
GROQ_MODEL_RESEARCHER=
GROQ_MODEL_PEDAGOGUE=
GROQ_MODEL_COACH=
GROQ_MODEL_WATCHER=

# --- Embarquement du RAG ---------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=mxbai-embed-large

# --- Quotas de génération (C13) -------------------------------------------
EDUAI_QUOTA_GENERATIONS_PAR_JOUR=15
EDUAI_PLAFOND_GENERATIONS_PAR_JOUR=200

# --- API du service IA -----------------------------------------------------
# Clés séparées par des virgules ; comparées à temps constant
SERVICE_IA_CLES=
SERVICE_IA_QUOTA_GENERATION=20
SERVICE_IA_QUOTA_RECHERCHE=100
SERVICE_IA_CONCURRENCE_MAX=4

# --- Stockages persistants (déploiement) -----------------------------------
# Volumes montés chez l'hébergeur ; laissés vides, les valeurs par défaut du
# projet s'appliquent.
EDUAI_MEDIA_REPERTOIRE=
MONITORAGE_REPERTOIRE=

# --- Supervision -----------------------------------------------------------
GRAFANA_UTILISATEUR=
GRAFANA_MOT_DE_PASSE=
