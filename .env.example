# --- Groq ---
GROQ_API_KEY=

# Modèle global (optionnel). Surchargé par les variables par agent ci-dessous.
# GROQ_MODEL=openai/gpt-oss-120b

# Routage par agent (optionnel — valeurs par défaut dans model_config.py)
# GROQ_MODEL_RESEARCHER=openai/gpt-oss-120b
# GROQ_MODEL_PEDAGOGUE=openai/gpt-oss-120b
# GROQ_MODEL_COACH=openai/gpt-oss-20b
# GROQ_MODEL_WATCHER=openai/gpt-oss-20b

# --- Repli local ---
USE_LOCAL_LLM=false
OLLAMA_EMBED_MODEL=mxbai-embed-large
OLLAMA_BASE_URL=http://localhost:11434

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

# --- PostgreSQL ---
# Une seule instance, deux bases : eduai_data pour le jeu de données du
# pipeline (C4), eduai_app pour l'application Django (C17). L'hôte, le port,
# le rôle et le mot de passe sont communs aux deux ; seul le nom diffère.
POSTGRES_USER=eduai
POSTGRES_PASSWORD=
# Base créée par le conteneur lui-même à partir de cette variable.
POSTGRES_DB=eduai_data
# Port publié par le conteneur sur la boucle locale, 5433 pour éviter le
# conflit avec une instance PostgreSQL déjà installée sur la machine.
POSTGRES_PORT=5433
POSTGRES_HOST=127.0.0.1

# Base lue par Django. Créée par data_pipeline/load/sql/00_bases.sql.
DJANGO_DB_NAME=eduai_app

# URL de connexion utilisée par le pipeline d'import, sur l'autre base.
DATABASE_URL=postgresql://eduai:MOT_DE_PASSE@127.0.0.1:5433/eduai_data

# --- Django : exposition et débogage ---
# Le code vaut False par défaut : une variable oubliée dégrade le confort de
# développement, jamais la sécurité de l'exposition.
DJANGO_DEBUG=True
# Liste séparée par des virgules. Y ajouter le domaine d'exposition seulement
# pendant qu'une démonstration l'exige, et l'en retirer ensuite.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# À passer à True uniquement derrière un terminateur TLS (proxy inverse,
# tunnel), jamais sur une exposition directe.
DJANGO_DERRIERE_PROXY=False
