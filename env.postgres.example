# --- PostgreSQL (jeu de données du Bloc 1) ---
# À ajouter au fichier .env existant. Ne jamais commiter .env.

POSTGRES_DB=eduai_data
POSTGRES_USER=eduai
POSTGRES_PASSWORD=change_moi_avec_un_mot_de_passe_fort
POSTGRES_PORT=5433

# URL de connexion utilisée par le pipeline d'import.
# Note : l'hôte est localhost car le pipeline s'exécute hors conteneur.
DATABASE_URL=postgresql://eduai:change_moi_avec_un_mot_de_passe_fort@localhost:5433/eduai_data
